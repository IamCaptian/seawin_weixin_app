/* 按钮样式 */
button {
  margin: 20rpx;
}

/* 图片容器 */
.image-container {
  margin: 20rpx;
  text-align: center;
}

/* 缩放后图片样式（widthFix 保持宽高比，宽度100%） */
.scaled-image {
  width: 100%;
  border: 1px solid #eee;
  border-radius: 8rpx;
}

/* 图片信息文本 */
.image-info {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666;
}

/* Canvas 隐藏样式（关键：不可见且不占空间） */
.canvas-hidden {
  position: fixed;
  top: -9999rpx;
  left: -9999rpx;
  width: 400px;
  height: 400px;
}

.hint-text {
  /* 定义文本颜色和大小 */
  color: #f5f5f5;
  font-size: 25px;
  /* 让文本自动换行 */
  word-break: break-all;
}

/*设备信息展示容器*/
.device_info-box {
  width: 100%;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  /* 关键：子元素垂直排列 */
  align-items: center;
  /* 子元素水平居中 */
  justify-content: center;
  /* 子元素垂直居中 */
  gap: 20rpx;
  /* 子元素之间的垂直间距（无需再写 margin-bottom） */

}
.gradient-box {
  /* 2. 叠加径向渐变：模拟中心发光效果（增强层次感） */
  background-image:
      linear-gradient(135deg, #93aeec 0%, #3b82f6 50%, #9674e7 100%),
      radial-gradient(circle at 20% 20%, rgba(59, 130, 246, 0.3) 0%, transparent 50%);
  /* 3. 发光边框：科技感标志性效果（模糊+半透明） */
  box-shadow:
      0 0 20rpx rgba(59, 130, 246, 0.5),
      /* 外发光（蓝色） */
      0 0 40rpx rgba(139, 92, 246, 0.3);
  /* 外发光（紫色，扩散更远） */
  /* 4. 圆角+内边距：保持容器精致感 */
  border-radius: 20rpx;
  /* 圆角稍大，更现代 */
  padding: 50rpx 30rpx;
  /* 增大内边距，避免内容贴边 */
  /* 5. 文字样式：增强对比，呼应科技感 */
  color: #ffffff;
  font-weight: bold;
  text-shadow: 0 0 8rpx rgba(255, 255, 255, 0.3);
  /* 文字轻微发光 */
}
.device-info_text {
  width: 100%;
  text-align: center;
  font-size: 35rpx;
  line-height: 1.5;

  /* --- 新增代码 --- */
  color: #ffffff;
  /* 设置字体颜色为白色 */
  font-weight: bold;
  /* 设置字体为加粗样式 */
  letter-spacing: 2rpx;
  /* 调整字体间距，单位推荐使用 rpx */
  text-align: left;
  /* 同时将文字本身也设置为左对齐（默认就是左对齐） */
  /* --- 新增代码结束 --- */
}
