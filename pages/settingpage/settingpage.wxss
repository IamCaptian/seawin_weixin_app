/* pages/settingpage/settingpage.wxss */
.ota-page {
  position: relative;
  min-height: 100vh;
  padding: 48rpx 32rpx 64rpx;
  background: linear-gradient(180deg, #0f7afe 0%, #52c7ff 48%, #f6f9ff 100%);
  box-sizing: border-box;
  overflow: hidden;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  filter: blur(2rpx);
  opacity: 0.35;
}

.bg-circle-1 {
  width: 520rpx;
  height: 520rpx;
  top: -220rpx;
  right: -200rpx;
  background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0) 70%);
}

.bg-circle-2 {
  width: 600rpx;
  height: 600rpx;
  bottom: -320rpx;
  left: -260rpx;
  background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0) 70%);
}

.ota-header {
  position: relative;
  z-index: 1;
  margin-bottom: 28rpx;
}

.ota-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.ota-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
}

.ota-card {
  position: relative;
  z-index: 1;
  padding: 28rpx 24rpx 32rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 50rpx rgba(15, 122, 254, 0.22);
  backdrop-filter: blur(10rpx);
  box-sizing: border-box;
}

.ota-card button {
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
}

.choose-btn {
  margin-top: 0;
}

.knx-btn {
  margin-bottom: 20rpx;
}

.flash-btn {
  margin-bottom: 20rpx;
}

.version-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 18rpx;
  margin-top: 6rpx;
  border-radius: 20rpx;
  background: rgba(15, 122, 254, 0.06);
  border: 1px solid rgba(15, 122, 254, 0.14);
}

.version-label {
  font-size: 26rpx;
  color: rgba(11, 27, 58, 0.7);
  letter-spacing: 2rpx;
}

.version-value {
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(11, 27, 58, 0.88);
  letter-spacing: 1rpx;
}
