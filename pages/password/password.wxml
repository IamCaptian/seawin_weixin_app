<view class="container">
  <!-- 密码输入卡片 -->
  <view class="card">
    <view class="title">请输入访问密码</view>
    
    <!-- 密码输入框 -->
    <view class="input-group">
      <input 
        type="password" 
        placeholder="请输入6位数字密码" 
        maxlength="6"
        bindinput="handlePasswordInput"
        value="{{password}}"
        class="password-input"
        placeholder-class="input-placeholder"
      />
    </view>
    
    <!-- 错误提示 -->
    <view wx:if="{{showError}}" class="error-message">{{errorMsg}}</view>
    
    <!-- 确认按钮 -->
    <button 
      bindtap="verifyPassword"
      class="confirm-btn"
      disabled="{{!password || password.length < 6}}"
    >
      确认访问
    </button>
    
    <!-- 密码提示 -->
    <view class="tip">提示：默认密码为 123456</view>
  </view>
</view>