.container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 20rpx;
  background-color: #f5f5f5;
}

.card {
  width: 100%;
  max-width: 500rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.08);
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 60rpx;
}

.input-group {
  margin-bottom: 30rpx;
}

.password-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  color: #333;
}

.password-input:focus {
  border-color: #2f80ed;
  outline: none;
}

.input-placeholder {
  color: #ccc;
  font-size: 28rpx;
}

.error-message {
  color: #e53e3e;
  font-size: 24rpx;
  margin-bottom: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
}

.confirm-btn {
  width: 100%;
  height: 90rpx;
  background: #2f80ed;
  color: #fff;
  font-size: 32rpx;
  border-radius: 12rpx;
  margin-top: 20rpx;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn[disabled] {
  background: #a0cfff;
  color: #fff;
}

.tip {
  margin-top: 30rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}